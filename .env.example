# Copy this file to `.env` and fill in real values. Never commit `.env`.

# Required. Your Anthropic API key. Read from the environment at runtime and
# never logged or sent anywhere except the Anthropic API.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional. Overrides the default Claude model used to draft messages.
# Leave unset to use the built-in default (claude-opus-4-8).
AICOMMIT_MODEL=claude-opus-4-8
